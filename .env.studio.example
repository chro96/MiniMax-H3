# Copy to .env.studio. The Studio reads this file on startup.
# T2VA (FL2VA partition) and Ref2VA use separate H3 servers.
H3_BASE_URL=http://127.0.0.1:30010
H3_REF_BASE_URL=http://127.0.0.1:30011
H3_API_KEY=
H3_POLL_SECONDS=3
H3_TIMEOUT_SECONDS=3600

# Optional Chat Completions-compatible text model for AI storyboard/corrections.
# Include /v1 if required by your server. Leave blank for manual editing.
STUDIO_LLM_BASE_URL=
STUDIO_LLM_MODEL=
STUDIO_LLM_API_KEY=
